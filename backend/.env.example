# ---- Copy to backend/.env for local development. Never commit a real .env. ----
# Full reference: docs/environment.md

ENVIRONMENT=development
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
TRUSTED_PROXY_COUNT=1
LOG_LEVEL=INFO

# Hosted strings (Neon etc.) can be pasted as-is: postgresql://...?sslmode=require works.
DATABASE_URL=postgresql+asyncpg://cf:cf@localhost:5432/contentfactory
REDIS_URL=redis://localhost:6379/0

# 32+ random characters each: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-dev-only-jwt-secret-0123456789abcdef
SESSION_SECRET=change-me-dev-only-session-secret-0123456789ab
# Comma-separated Fernet keys; first one encrypts. Required in production.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEYS=

# Auth switches (1/0)
AUTH_REQUIRE_EMAIL_VERIFICATION=1
AUTH_GOOGLE_ENABLED=0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
COOKIE_SECURE=0            # must be 1 in production (HTTPS)
COOKIE_DOMAIN=

# Email: console prints to the worker log; resend sends for real
EMAIL_PROVIDER=console
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=ContentFactory <hello@contentfactory.app>
SUPPORT_EMAIL=support@contentfactory.app

# Media storage: local (dev) or s3 (production). See docs/media-storage.md
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=var/storage
STORAGE_URL_TTL_SECONDS=3600
MEDIA_MAX_IMAGE_MB=25
MEDIA_MAX_VIDEO_MB=500
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=contentfactory
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# AI (Phase 3+). Models are configuration, never hard-coded.
AI_PROVIDER=mock            # mock (offline, dev only), anthropic or gemini
AI_PROVIDER_API_KEY=
AI_FAST_MODEL=
AI_REASONING_MODEL=
AI_IMAGE_MODEL=
AI_IMAGE_PROVIDER=mock          # mock (dev placeholder), openai (OpenAI-compatible) or gemini
AI_IMAGE_API_KEY=
AI_IMAGE_API_BASE_URL=https://api.openai.com/v1
# Video text font. Empty = auto (DejaVu on Linux, Arial Bold on Windows/macOS)
VIDEO_FONT_PATH=
AI_VIDEO_MODEL=
AI_EMBEDDING_MODEL=
AI_VOICE_MODEL=
AI_EMBEDDING_DIMENSIONS=1536
AI_EMBEDDING_PROVIDER=local     # local (no API), voyage or gemini; then run scripts.reembed_memory
AI_EMBEDDING_API_KEY=
AI_API_BASE_URL=https://api.anthropic.com
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
# Gemini only: thinking effort per role (minimal/low/medium/high, empty = model default)
AI_FAST_THINKING_LEVEL=low
AI_REASONING_THINKING_LEVEL=medium
AI_TIMEOUT_SECONDS=90
AI_CACHE_TTL_HOURS=336
# Optional cost tracking, USD per million tokens
AI_FAST_INPUT_USD_PER_MTOK=0
AI_FAST_OUTPUT_USD_PER_MTOK=0
AI_REASONING_INPUT_USD_PER_MTOK=0
AI_REASONING_OUTPUT_USD_PER_MTOK=0

# Paddle Billing (Phase 4)
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_STARTER_PRICE_ID=
PADDLE_BUSINESS_PRICE_ID=
PADDLE_AGENCY_PRICE_ID=
PADDLE_API_BASE_URL=        # optional override (local test stand-in)

# Social platforms (Phase 5). The worker needs these too. See docs/social-integrations.md
META_CLIENT_ID=
META_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
META_GRAPH_VERSION=v21.0
META_GRAPH_BASE_URL=
META_DIALOG_BASE_URL=
YOUTUBE_ENABLED=1

# Web push (Phase 8)
PUSH_PUBLIC_KEY=
PUSH_PRIVATE_KEY=
